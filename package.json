{
  "name": "ggx-web-automation",
  "version": "1.0.0",
  "description": "GoGoX b2b-website E2E test automation",
  "type": "module",
  "scripts": {
    "bdd:gen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:hk": "bddgen && playwright test --grep @hk",
    "test:e2e:sg": "bddgen && playwright test --grep @sg",
    "test:e2e:hk-zh": "bddgen && playwright test --grep \"@hk @zh\"",
    "test:e2e:hk-en": "bddgen && playwright test --grep \"@hk @en\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjccing/ggx-web-automation.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gjccing/ggx-web-automation/issues"
  },
  "homepage": "https://github.com/gjccing/ggx-web-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "dotenv": "^17.2.3",
    "playwright-bdd": "^9.1.0",
    "typescript": "^6.0.3"
  }
}
