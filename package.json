{
  "name": "ggx-web-automation",
  "version": "1.0.0",
  "description": "GoGoX cross-product web E2E test automation",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install",
    "bdd:gen": "bddgen",
    "test:e2e": "bddgen && playwright test --pass-with-no-tests",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:trace": "node scripts/test-e2e-trace.mjs",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjccing/ggx-web-automation.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gjccing/ggx-web-automation/issues"
  },
  "homepage": "https://github.com/gjccing/ggx-web-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "dotenv": "^17.2.3",
    "googleapis": "^173.0.0",
    "playwright-bdd": "^9.1.0",
    "typescript": "^6.0.3"
  }
}
