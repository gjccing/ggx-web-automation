# Per-product env vars (add-product skill writes these automatically)
# PREFIX = product name in SCREAMING_SNAKE, e.g. ggxb → GGXB

# GGXB — GoGoX Business (B2B portal), per-region staging URLs
GGXB_BASE_URL=https://hk-b2b-stag.gogox.com/
GGXB_HK_BASE_URL=https://hk-b2b-stag.gogox.com/
GGXB_SG_BASE_URL=https://sg-b2b-stag.gogox.com/

# GGXB — B2B portal test accounts (set real values in .env only; never commit secrets)
GGXB_HK_TEST_USER_EMAIL=your-email@example.com
GGXB_HK_TEST_USER_PASSWORD=
GGXB_SG_TEST_USER_EMAIL=your-email@example.com
GGXB_SG_TEST_USER_PASSWORD=

# GGXB — Driver app test accounts (per region; set real values in .env only)
GGXB_HK_DA_USER_PHONE=+85200000000
GGXB_HK_DA_USER_PASSWORD=
GGXB_SG_DA_USER_PHONE=+6500000000
GGXB_SG_DA_USER_PASSWORD=
