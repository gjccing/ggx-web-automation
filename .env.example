# Per-product env vars (add-product skill writes these automatically)
# PREFIX = product name in SCREAMING_SNAKE, e.g. ggxb → GGXB

# GGXB — GoGoX Business (B2B portal), per-region staging URLs
GGXB_HK_BASE_URL=https://hk-b2b-stag.gogox.com/
GGXB_SG_BASE_URL=https://sg-b2b-stag.gogox.com/

# Legacy HK alias (optional; used when GGXB_HK_BASE_URL is unset)
# GGXB_BASE_URL=https://hk-b2b-stag.gogox.com/
